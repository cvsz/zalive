# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# --- Albert production (see .env real) ---
ALBERT_HOST=0.0.0.0
ALBERT_LAN_HOST=192.168.1.123
ALBERT_HTTP_PORT=18090
ALBERT_HTTPS_PORT=18443
ALBERT_ADMIN_TOKEN=change-me-generate-with-python3-c-secrets-token_urlsafe
FAIRPLAY_KEY_PATH=certs/fairplay.key
FAIRPLAY_CERT_PATH=certs/fairplay.crt
ALBERT_ACCEPT_RISK=1


# --- mTLS: proxy → Albert (optional, enable for production) ---
# Generate: ./scripts/gen_mtls.sh or openssl req -new -x509 ... (see docs/RUNBOOK.md mTLS)
# ALBERT_MTLS_CA=certs/mtls-ca.crt
# ALBERT_MTLS_CERT=certs/mtls-client.crt
# ALBERT_MTLS_KEY=certs/mtls-client.key
# Optional hardening: shared-secret header for HTTP-mode mTLS (stronger than bare X-Client-Cert "present")
# ALBERT_MTLS_TOKEN=change-me-generate-with-python3-c-secrets-token_hex-32
# ALBERT_MTLS_ALLOW_HEADER_FALLBACK=1  # 1 = allow X-Client-Cert "present"/"mtls" from localhost in HTTP mode (spoofable); 0 = header-only rejected, require TLS or token
# Changing ALBERT_MTLS_CA requires gunicorn restart (gunicorn_conf.py: cert_reqs=2 at import — see docs/RUNBOOK.md)

# --- Rate limiting ---
# ALBERT_REDIS_URL=redis://127.0.0.1:6379/0  # distributed INCR+EXPIRE; if unset → in-memory per-worker
# ALBERT_REDIS_FAIL_CLOSED=0  # 1 = if Redis configured but unreachable, fail closed (429) instead of degraded in-memory

# --- FairPlay lab note ---
# FairPlayKeyData / AccountTokenCertificate / WildcardTicket are placeholder values (lab/research, pymobiledevice3).
# Real iOS devices require Apple-issued FairPlay certificates — placeholder is rejected on physical activation.
