# Albert Server Environment Configuration
# Copy to .env and customize for your deployment
# NEVER commit .env with real values

# =============================================================================
# REQUIRED: Legal risk acknowledgement (see SECURITY.md, NOTICE)
# Operator must explicitly acknowledge risk — do not copy as-is.
# =============================================================================
# ALBERT_ACCEPT_RISK=1
ALBERT_ACCEPT_RISK=0

# =============================================================================
# Server Configuration — secure-by-default: localhost-only
# For LAN access, override with ALBERT_HOST=0.0.0.0 and set ALBERT_LAN_HOST
# =============================================================================
ALBERT_HOST=127.0.0.1
ALBERT_HTTP_PORT=18090
ALBERT_HTTPS_PORT=18443
ALBERT_MODE=prod
LOG_LEVEL=info

# =============================================================================
# FairPlay Key Paths (persisted with 0600 perms)
# =============================================================================
FAIRPLAY_KEY_PATH=certs/fairplay.key
FAIRPLAY_CERT_PATH=certs/fairplay.crt

# =============================================================================
# Admin API Token (generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
# =============================================================================
ALBERT_ADMIN_TOKEN=change-me-generate-with-python-secrets-token_urlsafe-32

# =============================================================================
# Rate Limiting (optional Redis for distributed rate limiting)
# =============================================================================
# ALBERT_REDIS_URL=redis://localhost:6379/0
# ALBERT_RATE_LIMIT_PER_UDID=10

# =============================================================================
# mTLS Proxy -> Albert (required for production/lab with any network exposure)
# Set ALBERT_MTLS_CA to enforce mTLS; for localhost-only, optional but recommended.
# =============================================================================
# ALBERT_MTLS_CA=certs/mtls_ca.crt
# ALBERT_MTLS_CERT=certs/mtls_client.crt
# ALBERT_MTLS_KEY=certs/mtls_client.key

# =============================================================================
# Database (optional override)
# =============================================================================
# ALBERT_DB_PATH=logs/activations.db

# =============================================================================
# OpenTelemetry Tracing (optional)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=albert-server

# =============================================================================
# Firmware Cache (optional override)
# =============================================================================
# FIRMWARE_CACHE_PATH=logs/firmware_cache.json

# =============================================================================
# mitmproxy Configuration — MITMPROXY_WEB_PASSWORD must be set (no default)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
# =============================================================================
MITMPROXY_WEB_PASSWORD=change-me-generate-with-python-secrets-token_urlsafe-16
# Failure to set a strong password will cause mitmproxy to refuse startup (see docker-compose).
MITMPROXY_WEB_PORT=8081
MITMPROXY_PORT=8082
LOCAL_ALBERT_HOST=127.0.0.1
LOCAL_ALBERT_PORT=18090
LOCAL_ALBERT_SCHEME=http

# =============================================================================
# LAN Access (optional, for dashboard access from other devices)
# =============================================================================
# ALBERT_LAN_HOST=192.168.1.100