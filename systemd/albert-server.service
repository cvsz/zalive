# Albert Activation Server — systemd unit
# Install & enable:
#   sudo cp systemd/albert-server.service /etc/systemd/system/albert-server.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now albert-server
# Verify:
#   systemctl is-enabled albert-server   # should print "enabled"
#   systemctl status albert-server
#   journalctl -u albert-server -f
# Disable:
#   sudo systemctl disable --now albert-server
[Unit]
Description=Albert Activation Server
After=network.target
Wants=network.target

[Service]
User=cvsz
WorkingDirectory=/home/cvsz/albert_server
ExecStart=/home/cvsz/albert_server/venv/bin/gunicorn -c /home/cvsz/albert_server/gunicorn_conf.py albert_server:app
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/cvsz/albert_server/.env
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
